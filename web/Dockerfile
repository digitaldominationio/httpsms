# build stage
FROM node:22-alpine AS build

# Build-time environment (injected by Coolify/compose args)
ARG API_BASE_URL=http://localhost:8000
ARG APP_URL=http://localhost:3000
ARG APP_NAME=httpSMS
ARG APP_ENV=production
ARG APP_GITHUB_URL=https://github.com/NdoleStudio/httpsms
ARG APP_DOCUMENTATION_URL=https://docs.httpsms.com
ARG APP_DOWNLOAD_URL=https://github.com/NdoleStudio/httpsms/releases/latest/download/HttpSms.apk
ARG FIREBASE_API_KEY=
ARG FIREBASE_AUTH_DOMAIN=
ARG FIREBASE_PROJECT_ID=
ARG FIREBASE_STORAGE_BUCKET=
ARG FIREBASE_MESSAGING_SENDER_ID=
ARG FIREBASE_APP_ID=
ARG FIREBASE_MEASUREMENT_ID=
ARG CLOUDFLARE_TURNSTILE_SITE_KEY=
ARG PUSHER_KEY=
ARG PUSHER_CLUSTER=

ENV API_BASE_URL=$API_BASE_URL
ENV APP_URL=$APP_URL
ENV APP_NAME=$APP_NAME
ENV APP_ENV=$APP_ENV
ENV APP_GITHUB_URL=$APP_GITHUB_URL
ENV APP_DOCUMENTATION_URL=$APP_DOCUMENTATION_URL
ENV APP_DOWNLOAD_URL=$APP_DOWNLOAD_URL
ENV FIREBASE_API_KEY=$FIREBASE_API_KEY
ENV FIREBASE_AUTH_DOMAIN=$FIREBASE_AUTH_DOMAIN
ENV FIREBASE_PROJECT_ID=$FIREBASE_PROJECT_ID
ENV FIREBASE_STORAGE_BUCKET=$FIREBASE_STORAGE_BUCKET
ENV FIREBASE_MESSAGING_SENDER_ID=$FIREBASE_MESSAGING_SENDER_ID
ENV FIREBASE_APP_ID=$FIREBASE_APP_ID
ENV FIREBASE_MEASUREMENT_ID=$FIREBASE_MEASUREMENT_ID
ENV CLOUDFLARE_TURNSTILE_SITE_KEY=$CLOUDFLARE_TURNSTILE_SITE_KEY
ENV PUSHER_KEY=$PUSHER_KEY
ENV PUSHER_CLUSTER=$PUSHER_CLUSTER

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

# Install pnpm
RUN npm install -g pnpm

RUN pnpm install

COPY . .
RUN pnpm run generate

# production stage
FROM nginx:stable-alpine AS production
COPY --from=build /app/.output/public /usr/share/nginx/html

# Copy the nginx configuration file
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
